rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {

function signedIn() {
  return request.auth != null;
}

function isGroupMember(groupId) {
  return signedIn()
    && request.auth.uid in
    get(/databases/$(database)/documents/groups/$(groupId)).data.members;
}

function isChannelOwner(channelId) {
  return signedIn()
    && get(/databases/$(database)/documents/channels/$(channelId)).data.ownerId
    == request.auth.uid;
}

// USER PROFILES
match /users/{userId} {
  allow read: if signedIn();
  allow create, update: if signedIn()
    && request.auth.uid == userId;
  allow delete: if false;
}

// PUBLIC PROFILES
match /public_profiles/{userId} {
  allow read: if signedIn();

  allow create, update: if signedIn()
    && request.auth.uid == userId
    && request.resource.data.keys().hasOnly([
      "uid",
      "username",
      "usernameLower",
      "displayName",
      "photoURL",
      "bio",
      "updatedAt"
    ])
    && request.resource.data.uid == userId;

  allow delete: if false;
}

// PUBLIC MESSAGES
match /messages/{messageId} {
  allow read: if signedIn();

  allow create: if signedIn()
    && request.resource.data.senderId == request.auth.uid
    && request.resource.data.text is string
    && request.resource.data.text.size() > 0
    && request.resource.data.text.size() <= 2000;

  allow update, delete: if false;
}

// PRIVATE CHATS
match /private_chats/{chatId} {

  allow create: if signedIn()
    && request.resource.data.keys().hasOnly([
      "participants",
      "createdAt"
    ])
    && request.resource.data.participants is list
    && request.resource.data.participants.size() == 2
    && request.auth.uid in request.resource.data.participants;

  allow get: if signedIn()
    && (
      !exists(/databases/$(database)/documents/private_chats/$(chatId))
      || request.auth.uid in resource.data.participants
    );

  allow list: if signedIn()
    && request.auth.uid in resource.data.participants;

  allow update, delete: if false;

  // PRIVATE CHAT MESSAGES
  match /messages/{messageId} {

    function isChatParticipant() {
      return signedIn()
        && request.auth.uid in
        get(/databases/$(database)/documents/private_chats/$(chatId)).data.participants;
    }

    function validMessageFields() {
      return request.resource.data.keys().hasOnly([
        "text",
        "senderId",
        "senderName",
        "createdAt",
        "type",
        "mediaURL",
        "mediaPath",
        "mediaType",
        "mediaName",
        "sticker",
        "replyTo",
        "deliveredAt",
        "readAt",
        "editedAt",
        "reactions"
      ]);
    }

    allow read: if isChatParticipant();

    // SEND MESSAGES, MEDIA, STICKERS AND REPLIES
    allow create: if isChatParticipant()
      && validMessageFields()
      && request.resource.data.senderId == request.auth.uid
      && request.resource.data.senderName is string
      && request.resource.data.createdAt == request.time
      && (
        !("text" in request.resource.data)
        || (
          request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
        )
      )
      && (
        !("mediaURL" in request.resource.data)
        || request.resource.data.mediaURL is string
      )
      && (
        !("mediaPath" in request.resource.data)
        || request.resource.data.mediaPath is string
      )
      && (
        !("mediaType" in request.resource.data)
        || request.resource.data.mediaType is string
      )
      && (
        !("mediaName" in request.resource.data)
        || request.resource.data.mediaName is string
      )
      && (
        !("sticker" in request.resource.data)
        || request.resource.data.sticker is string
      );

    // UPDATE MESSAGES
    allow update: if isChatParticipant()
      && (

        // EDIT YOUR OWN MESSAGES
        (
          request.auth.uid == resource.data.senderId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "text",
              "editedAt"
            ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.editedAt == request.time
        )

        ||

        // DELIVERY AND READ RECEIPTS
        (
          request.auth.uid != resource.data.senderId
          && request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly([
              "deliveredAt",
              "readAt"
            ])
          && (
            !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(["deliveredAt"])
            || request.resource.data.deliveredAt == request.time
          )
          && (
            !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(["readAt"])
            || request.resource.data.readAt == request.time
          )
        )

        ||

        // EMOJI REACTIONS
        (
          request.resource.data.diff(resource.data)
            .affectedKeys().hasOnly(["reactions"])
          && request.resource.data.reactions is map
        )
      );

    // DELETE YOUR OWN MESSAGES
    allow delete: if isChatParticipant()
      && request.auth.uid == resource.data.senderId;
  }
}

// GROUPS
match /groups/{groupId} {

  allow create: if signedIn()
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.members is list
    && request.auth.uid in request.resource.data.members
    && request.resource.data.members.size() >= 2
    && request.resource.data.members.size() <= 100;

  allow read: if signedIn()
    && request.auth.uid in resource.data.members;

  allow update, delete: if false;

  match /messages/{messageId} {
    allow read: if isGroupMember(groupId);

    allow create: if isGroupMember(groupId)
      && request.resource.data.senderId == request.auth.uid
      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 2000;

    allow update, delete: if false;
  }
}

// CHANNELS
match /channels/{channelId} {

  allow create: if signedIn()
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0;

  allow read: if signedIn();
  allow update, delete: if false;

  match /posts/{postId} {
    allow read: if signedIn();

    allow create: if isChannelOwner(channelId)
      && request.resource.data.senderId == request.auth.uid
      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 5000;

    allow update, delete: if false;
  }
}

}
}
